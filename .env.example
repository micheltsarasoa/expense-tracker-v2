# Copy to apps/web/.env.local (Next.js) and to .env at the root (drizzle-kit, scripts).
# Never commit real values. The web server refuses to start if a value is missing or invalid
# (schema: apps/web/lib/env.ts).

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/expense_tracker"

# Stack Auth (https://app.stack-auth.com → project → API keys)
NEXT_PUBLIC_STACK_PROJECT_ID="00000000-0000-4000-8000-000000000000"
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY="pck_..."
STACK_SECRET_SERVER_KEY="ssk_..."

# Optional: fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL="info"
