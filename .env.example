# -------------------------------------------------------
# Root — shared by all packages
# Copy to .env and fill in real values. Never commit .env
# -------------------------------------------------------

# Neon PostgreSQL connection string
# Get from: console.neon.tech → your project → Connection string
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# -------------------------------------------------------
# apps/web — copy to apps/web/.env.local
# -------------------------------------------------------

# Neon Auth secret key
# Get from: console.neon.tech → your project → Auth → API Keys
NEON_AUTH_SECRET="your-neon-auth-secret"

# Public base URL of the web app (used by mobile to call the API)
NEXT_PUBLIC_API_URL="http://localhost:3000"

# -------------------------------------------------------
# apps/mobile — copy to apps/mobile/.env
# -------------------------------------------------------

# API base URL consumed by the Expo app
EXPO_PUBLIC_API_URL="http://localhost:3000"
