{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.85", "--headless", "--isolated"]
    },
    "postgres": {
      "type": "stdio",
      "command": "uvx",
      "args": ["postgres-mcp==0.3.0", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "${MCP_POSTGRES_URL:-postgresql://postgres:postgres@localhost:5432/expense_tracker}"
      }
    }
  }
}
